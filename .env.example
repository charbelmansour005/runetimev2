# Copy to .env and fill in. Never commit .env.
# Don't put NODE_ENV=development here: Vite also reads this file and would
# produce a development build. Leave NODE_ENV unset locally; set
# NODE_ENV=production on your host.

PORT=4000

# MongoDB Atlas → Connect → Drivers. Keep the database name in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/runtimecollective?appName=Cluster0

# Long random string that signs CMS sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First CMS admin — created automatically while there are no CMS users yet.
ADMIN_EMAIL=admin@runtimecollective.com
ADMIN_PASSWORD=

# Production behind a reverse proxy (Render, Railway, Heroku, Nginx…):
# how many proxies sit in front of the app.
# TRUST_PROXY=1

# Session cookies are HTTPS-only in production. Set to false only to try
# the production build locally over plain http.
# COOKIE_SECURE=false
